# Saat Anda menghubungkan proyek Vercel ini ke sebuah Vercel Postgres store,
# variabel-variabel di bawah ini akan otomatis diisi oleh Vercel.
# Untuk pengembangan lokal, salin file ini menjadi .env.local dan isi
# nilainya (bisa didapat dari tab "Storage" -> ".env.local" di dashboard Vercel).
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Login: satu kata sandi bersama untuk seluruh tim. Tanpa dua variabel ini,
# aplikasi menolak semua akses (bukan terbuka). Wajib diisi juga di Vercel
# (Settings -> Environment Variables) sebelum deploy.
APP_PASSWORD=
# Kunci penanda tangan sesi, minimal 16 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
